# docker-compose.yml에서 사용하는 환경변수 예시입니다.
# 실제 값을 채운 .env 파일을 프로젝트 루트에 만들어 사용하세요. (.env는 git에 커밋되지 않습니다.)

# Oracle DB 계정 비밀번호 (system 계정, meeting-api 접속 비밀번호와 동일하게 사용됨)
DB_PASSWORD=changeme

# meeting-api가 접속할 DB 사용자명 (기본값: system)
DB_USERNAME=system

# JWT 서명에 사용되는 비밀키 (최소 32자 이상 권장)
JWT_SECRET=changeme-please-use-a-strong-secret-key-min-32-chars
